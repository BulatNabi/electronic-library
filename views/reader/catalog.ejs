<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <%- include('../partials/notification') %>

  <main class="container">
    <div class="page-header">
      <h1>Каталог документов</h1>
    </div>

    <div class="search-bar">
      <form id="searchForm" action="/reader/search" method="GET" class="search-form">
        <input type="text" name="query" id="search-query" placeholder="Поиск по названию или автору..."
               class="form-control" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        <select name="category" id="search-category" class="form-control">
          <option value="all">Все категории</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.ID_Category %>"
                    <%= (typeof searchCategory !== 'undefined' && searchCategory == cat.ID_Category) ? 'selected' : '' %>>
              <%= cat.Category_name %>
            </option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-primary">Найти</button>
      </form>
    </div>

    <div class="documents-grid" id="documents-grid">
      <% if (documents.length === 0) { %>
        <p class="empty-state">По вашему запросу ничего не найдено.</p>
      <% } %>

      <% documents.forEach(doc => { %>
        <div class="doc-card" id="doc-card-<%= doc.ID_Document %>">
          <div class="doc-card-header">
            <h3 class="doc-title"><a href="/reader/documents/<%= doc.ID_Document %>"><%= doc.Title %></a></h3>
            <span class="doc-category"><%= doc.Category_name || 'Без категории' %></span>
          </div>
          <div class="doc-card-body">
            <p class="doc-author"><strong>Автор:</strong> <%= doc.Author %></p>
            <p class="doc-year"><strong>Год:</strong> <%= doc.Year %></p>
            <p class="doc-annotation"><%= doc.Annotation ? doc.Annotation.substring(0, 150) + (doc.Annotation.length > 150 ? '...' : '') : '' %></p>
          </div>
          <div class="doc-card-footer">
            <a href="/reader/documents/<%= doc.ID_Document %>" class="btn btn-sm btn-outline">Подробнее</a>
            <a href="/reader/documents/<%= doc.ID_Document %>/download" class="btn btn-sm btn-primary">Скачать</a>
            <% if (favorites.includes(doc.ID_Document)) { %>
              <button class="btn btn-sm btn-favorite active" onclick="toggleFavorite(<%= doc.ID_Document %>, this)" data-fav="true">&#9733; В избранном</button>
            <% } else { %>
              <button class="btn btn-sm btn-favorite" onclick="toggleFavorite(<%= doc.ID_Document %>, this)" data-fav="false">&#9734; В избранное</button>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <script src="/js/common.js"></script>
  <script src="/js/reader.js"></script>
</body>
</html>
