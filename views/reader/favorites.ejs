<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <%- include('../partials/notification') %>

  <main class="container">
    <div class="page-header">
      <h1>Избранное</h1>
    </div>

    <div class="search-bar">
      <form id="searchForm" action="/reader/favorites" method="GET" class="search-form">
        <input type="text" name="query" id="search-query" placeholder="Поиск по названию или автору..."
               class="form-control" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        <select name="category" id="search-category" class="form-control">
          <option value="all">Все категории</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.ID_Category %>"
                    <%= (typeof searchCategory !== 'undefined' && searchCategory == cat.ID_Category) ? 'selected' : '' %>>
              <%= cat.Category_name %>
            </option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-primary">Найти</button>
        <% if ((typeof searchQuery !== 'undefined' && searchQuery) || (typeof searchCategory !== 'undefined' && searchCategory && searchCategory !== 'all')) { %>
          <a href="/reader/favorites" class="btn btn-outline">Сбросить</a>
        <% } %>
      </form>
    </div>

    <% if (favorites.length === 0) { %>
      <p class="empty-state">
        <% if ((typeof searchQuery !== 'undefined' && searchQuery) || (typeof searchCategory !== 'undefined' && searchCategory && searchCategory !== 'all')) { %>
          По вашему запросу в избранном ничего не найдено.
        <% } else { %>
          В вашем списке избранного пока нет документов.
        <% } %>
      </p>
    <% } else { %>
      <div class="documents-grid">
        <% favorites.forEach(fav => { %>
          <div class="doc-card" id="fav-card-<%= fav.ID_Document %>">
            <div class="doc-card-header">
              <h3 class="doc-title"><a href="/reader/documents/<%= fav.ID_Document %>"><%= fav.Title %></a></h3>
              <span class="doc-category"><%= fav.Category_name || 'Без категории' %></span>
            </div>
            <div class="doc-card-body">
              <p class="doc-author"><strong>Автор:</strong> <%= fav.Author %></p>
              <p class="doc-year"><strong>Год:</strong> <%= fav.Year %></p>
            </div>
            <div class="doc-card-footer">
              <a href="/reader/documents/<%= fav.ID_Document %>" class="btn btn-sm btn-outline">Подробнее</a>
              <a href="/reader/documents/<%= fav.ID_Document %>/download" class="btn btn-sm btn-primary">Скачать</a>
              <button class="btn btn-sm btn-danger" onclick="removeFavoriteFromList(<%= fav.ID_Document %>)">Удалить из избранного</button>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <script src="/js/common.js"></script>
  <script src="/js/reader.js"></script>
</body>
</html>
