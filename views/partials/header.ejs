<header class="header">
  <div class="header-container">
    <a href="/" class="logo">Электронная библиотека документов</a>
    <% if (currentUser) { %>
      <nav class="nav">
        <% if (currentUser.role === 'Администратор') { %>
          <a href="/admin/users" class="nav-link">Пользователи</a>
        <% } else if (currentUser.role === 'Библиотекарь') { %>
          <a href="/librarian/documents" class="nav-link">Документы</a>
          <a href="/librarian/categories" class="nav-link">Категории</a>
          <a href="/librarian/stats" class="nav-link">Статистика</a>
        <% } else { %>
          <a href="/reader" class="nav-link">Каталог</a>
          <a href="/reader/favorites" class="nav-link">Избранное</a>
        <% } %>
      </nav>
      <div class="user-info">
        <a href="/auth/profile" class="user-info-link">
          <% if (currentUser.photo) { %>
            <img src="/uploads/<%= currentUser.photo %>" alt="Фото" class="header-photo">
          <% } %>
          <span class="user-name"><%= currentUser.fullName %></span>
          <span class="user-role">(<%= currentUser.role %>)</span>
        </a>
        <a href="/auth/logout" class="btn btn-sm btn-outline">Выход</a>
      </div>
    <% } %>
  </div>
</header>
