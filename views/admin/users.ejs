<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <%- include('../partials/notification') %>

  <main class="container">
    <div class="page-header">
      <h1><%= title %></h1>
      <button class="btn btn-primary" onclick="openAddUserModal()">Добавить пользователя</button>
    </div>

    <div class="search-bar">
      <form id="searchForm" action="/admin/users" method="GET" class="search-form">
        <input type="text" name="query" id="search-query" placeholder="Поиск по ФИО, логину или email..."
               class="form-control" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        <select name="role" id="search-role" class="form-control">
          <option value="all">Все роли</option>
          <% roles.forEach(role => { %>
            <option value="<%= role.ID_Role %>"
                    <%= (typeof searchRole !== 'undefined' && searchRole == role.ID_Role) ? 'selected' : '' %>>
              <%= role.Role_name %>
            </option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-primary">Найти</button>
        <% if ((typeof searchQuery !== 'undefined' && searchQuery) || (typeof searchRole !== 'undefined' && searchRole && searchRole !== 'all')) { %>
          <a href="/admin/users" class="btn btn-outline">Сбросить</a>
        <% } %>
      </form>
    </div>

    <table class="table">
      <thead>
        <tr>
          <th>Фото</th>
          <th>ID</th>
          <th>Логин</th>
          <th>ФИО</th>
          <th>Email</th>
          <th>Роль</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody id="users-table-body">
        <% users.forEach(user => { %>
          <tr id="user-row-<%= user.ID_User %>">
            <td>
              <div class="user-photo-cell" id="photo-cell-<%= user.ID_User %>">
                <% if (user.Photo) { %>
                  <img src="/uploads/<%= user.Photo %>" alt="Фото" class="user-photo-thumb">
                <% } else { %>
                  <div class="user-photo-placeholder"><%= user.FullName.charAt(0) %></div>
                <% } %>
              </div>
            </td>
            <td><%= user.ID_User %></td>
            <td><%= user.Login %></td>
            <td><%= user.FullName %></td>
            <td><%= user.Email %></td>
            <td>
              <select class="form-control form-control-sm role-select"
                      data-user-id="<%= user.ID_User %>"
                      onchange="changeRole(<%= user.ID_User %>, this.value)"
                      <%= user.ID_User === currentUser.id ? 'disabled' : '' %>>
                <% roles.forEach(role => { %>
                  <option value="<%= role.ID_Role %>" <%= user.ID_Role === role.ID_Role ? 'selected' : '' %>>
                    <%= role.Role_name %>
                  </option>
                <% }) %>
              </select>
            </td>
            <td class="actions">
              <button class="btn btn-sm btn-outline" onclick="openPhotoModal(<%= user.ID_User %>)">Фото</button>
              <button class="btn btn-sm btn-outline" onclick="openEditUserModal(<%= user.ID_User %>)">Редактировать</button>
              <% if (user.ID_User !== currentUser.id) { %>
                <button class="btn btn-sm btn-danger" onclick="deleteUser(<%= user.ID_User %>)">Удалить</button>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (users.length === 0) { %>
      <p class="empty-state">Пользователи не найдены.</p>
    <% } %>
  </main>

  <div id="addUserModal" class="modal hidden">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Добавить пользователя</h2>
        <button class="modal-close" onclick="closeModal('addUserModal')">&times;</button>
      </div>
      <form id="addUserForm" onsubmit="createUser(event)">
        <div class="form-group">
          <label for="add-fullName">ФИО</label>
          <input type="text" id="add-fullName" name="fullName" required class="form-control">
        </div>
        <div class="form-group">
          <label for="add-email">Email</label>
          <input type="email" id="add-email" name="email" required class="form-control">
        </div>
        <div class="form-group">
          <label for="add-roleId">Роль</label>
          <select id="add-roleId" name="roleId" required class="form-control">
            <% roles.forEach(role => { %>
              <option value="<%= role.ID_Role %>"><%= role.Role_name %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Создать</button>
      </form>
      <div id="credentials-display" class="credentials hidden">
        <h3>Учётные данные:</h3>
        <p>Логин: <strong id="cred-login"></strong></p>
        <p>Пароль: <strong id="cred-password"></strong></p>
      </div>
    </div>
  </div>

  <div id="editUserModal" class="modal hidden">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Редактировать профиль</h2>
        <button class="modal-close" onclick="closeModal('editUserModal')">&times;</button>
      </div>
      <form id="editUserForm" onsubmit="updateUser(event)">
        <input type="hidden" id="edit-userId">
        <div class="form-group">
          <label for="edit-fullName">ФИО</label>
          <input type="text" id="edit-fullName" name="fullName" required class="form-control">
        </div>
        <div class="form-group">
          <label for="edit-email">Email</label>
          <input type="email" id="edit-email" name="email" required class="form-control">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Сохранить</button>
      </form>
    </div>
  </div>

  <div id="photoModal" class="modal hidden">
    <div class="modal-content modal-sm">
      <div class="modal-header">
        <h2>Фото пользователя</h2>
        <button class="modal-close" onclick="closeModal('photoModal')">&times;</button>
      </div>
      <div id="photo-preview" class="photo-preview"></div>
      <form id="photoForm" onsubmit="uploadPhoto(event)" enctype="multipart/form-data">
        <input type="hidden" id="photo-userId">
        <div class="form-group">
          <label for="photo-file">Выберите изображение</label>
          <input type="file" id="photo-file" name="photo" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp">
        </div>
        <div class="modal-actions">
          <button type="submit" class="btn btn-primary">Загрузить</button>
          <button type="button" class="btn btn-danger" id="delete-photo-btn" onclick="deletePhoto()">Удалить фото</button>
        </div>
      </form>
    </div>
  </div>

  <div id="confirmModal" class="modal hidden">
    <div class="modal-content modal-sm">
      <div class="modal-header">
        <h2>Подтверждение</h2>
        <button class="modal-close" onclick="closeModal('confirmModal')">&times;</button>
      </div>
      <p id="confirm-text"></p>
      <div class="modal-actions">
        <button class="btn btn-danger" id="confirm-btn">Удалить</button>
        <button class="btn btn-outline" onclick="closeModal('confirmModal')">Отмена</button>
      </div>
    </div>
  </div>

  <script src="/js/common.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>
